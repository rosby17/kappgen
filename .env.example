# Izivoice API Key for Voiceover & Music (https://www.izivoice.app/api-docs)
IZIVOICE_API_KEY=
# Optional: pin a specific voice_id (see GET /voices). Left empty = auto-pick first available voice.
IZIVOICE_VOICE_ID=

# AI Image Provider — ai33.pro (https://api.ai33.pro). Leave empty to only use the
# local image-folder mode (image_style.source = "library").
AI_IMAGE_PROVIDER_API_KEY=
AI_IMAGE_PROVIDER_ENDPOINT=https://api.ai33.pro
AI_IMAGE_MODEL_ID=bytedance-seedream-4.5

# Supabase Credentials (optional — for production cloud DB; leave empty to use local SQLite)
SUPABASE_URL=
SUPABASE_KEY=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_DATABASE_URL=

# Storage & DB Config (defaults to Supabase Postgres if set above, else local SQLite)
DATABASE_URL=sqlite:///./data/app.db
STORAGE_PATH=./storage
ASSETS_PATH=./assets
