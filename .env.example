# Izivoice API Key for Voiceover & Music (https://www.izivoice.app/api-docs)
IZIVOICE_API_KEY=
# Optional: pin a specific voice_id (see GET /voices). Left empty = auto-pick first available voice.
IZIVOICE_VOICE_ID=

# AI Image Provider — ai33.pro (https://api.ai33.pro). Leave empty to only use the
# local image-folder mode (image_style.source = "library").
AI_IMAGE_PROVIDER_API_KEY=
AI_IMAGE_PROVIDER_ENDPOINT=https://api.ai33.pro
AI_IMAGE_MODEL_ID=gemini-2.5-flash-image

# Storage & DB Config. Defaults to local SQLite — zero setup needed.
# Optionally point DATABASE_URL at a dedicated Postgres instance instead
# (must be its own database, never shared with another project's DB).
DATABASE_URL=sqlite:///./data/app.db
# macOS + Documents folder gotcha: if this project lives under ~/Documents with
# iCloud "Desktop & Documents Folders" sync on, large freshly-written video files
# can get evicted/corrupted mid-render. Point STORAGE_PATH somewhere outside
# iCloud sync scope (e.g. ~/.nichecut-storage) for local dev if you hit this.
STORAGE_PATH=./storage
ASSETS_PATH=./assets
